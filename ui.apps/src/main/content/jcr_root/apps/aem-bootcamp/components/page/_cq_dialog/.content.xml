<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    xmlns:granite="http://www.adobe.com/jcr/granite/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0"
    xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="Page"
    sling:resourceType="cq/gui/components/authoring/dialog"
    extraClientlibs="[cq.common.wcm,core.wcm.components.page.v2.editor,cq.wcm.msm.properties,granite.contexthub.configuration,cq.siteadmin.admin.properties,cq.authoring.editor.hook.page]"
    helpPath="https://www.adobe.com/go/aem_cmp_page_v2"
    mode="edit"
    trackingFeature="core-components:page:v2">
    <content
        granite:class="cq-dialog-content-page"
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/container">
        <items jcr:primaryType="nt:unstructured">
            <tabs
                granite:class="cq-siteadmin-admin-properties-tabs"
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/tabs"
                size="L">
                <items jcr:primaryType="nt:unstructured">
                    <aem-bootcamp
                        jcr:primaryType="nt:unstructured"
                        jcr:title="AEM Bootcamp"
                        sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns">
                        <items jcr:primaryType="nt:unstructured">
                            <clientlib
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/includeclientlibs"
                                categories="cq.authoring.editor.hook.page"
                            />
                            <column
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/container">
                                <items jcr:primaryType="nt:unstructured">
                                    <migration
                                        jcr:primaryType="nt:unstructured"
                                        jcr:title="Migration"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/fieldset">
                                        <items jcr:primaryType="nt:unstructured">
                                            <legacy-path
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                                                composite="{Boolean}true"
                                                fieldLabel="Legacy Path">
                                                <field
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/container"
                                                    name="./columns">
                                                    <items jcr:primaryType="nt:unstructured">
                                                        <path
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                            fieldDescription="This is old URL of the page being authored and will be used while migration."
                                                            fieldLabel="Path"
                                                            name="./path" />
                                                    </items>
                                                </field>
                                            </legacy-path>
                                        </items>
                                    </migration>
                                    <navigation
                                        jcr:primaryType="nt:unstructured"
                                        jcr:title="Navigation"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/fieldset">
                                        <items jcr:primaryType="nt:unstructured">
                                            <show-in-navigation
                                                cq:showOnCreate="{Boolean}true"
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                                fieldDescription="If this page has to appear in the Top navigation, this checkbox has be selected."
                                                name="./isShowInNavigation"
                                                text="Show in Top Navigation" />
                                        </items>
                                    </navigation>
                                </items>
                            </column>
                        </items>
                    </aem-bootcamp>
                    <open-graph
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Open Graph"
                        sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns">
                        <items jcr:primaryType="nt:unstructured">
                            <column
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/container">
                                <items jcr:primaryType="nt:unstructured">
                                    <title
                                        granite:class="page-title-field"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                        fieldLabel="og:title"
                                        name="./title"
                                        required="{Boolean}false"/>
                                    <description
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                        fieldLabel="og:description"
                                        name="./description"
                                        required="{Boolean}false"/>
                                    <type
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                        fieldLabel="og:type"
                                        name="./type"
                                        required="{Boolean}false">
                                        <items jcr:primaryType="nt:unstructured">
                                            <item1
                                                jcr:primaryType="nt:unstructured"
                                                text="default"
                                                value="default"/>
                                            <item2
                                                jcr:primaryType="nt:unstructured"
                                                text="website"
                                                value="website"/>
                                            <item3
                                                jcr:primaryType="nt:unstructured"
                                                text="article"
                                                value="article"/>
                                            <item4
                                                jcr:primaryType="nt:unstructured"
                                                text="blog"
                                                value="blog"/>
                                        </items>
                                    </type>
                                    <image
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                        fieldLabel="og:image"
                                        name="./image"
                                        required="{Boolean}false"
                                        rootPath="/content/dam"
                                        emptyText="Select Image"/>
                                    <card
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                        fieldLabel="twitter:card"
                                        name="./card"
                                        required="{Boolean}false">
                                        <items jcr:primaryType="nt:unstructured">
                                            <item1
                                                jcr:primaryType="nt:unstructured"
                                                text="default"
                                                value="default"/>
                                            <item2
                                                jcr:primaryType="nt:unstructured"
                                                text="summary"
                                                value="summary"/>
                                            <item3
                                                jcr:primaryType="nt:unstructured"
                                                text="blog"
                                                value="blog"/>
                                            <item4
                                                jcr:primaryType="nt:unstructured"
                                                text="helps"
                                                value="helps"/>
                                        </items>
                                    </card>
                                    <url
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/hidden"
                                        fieldLabel="og:Url"
                                        name="./url"/>
                                </items>
                            </column>
                        </items>
                    </open-graph>
                </items>
            </tabs>
        </items>
    </content>
</jcr:root>