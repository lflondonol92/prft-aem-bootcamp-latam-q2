                            jcr:lastModifiedBy="admin"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="aem-bootcamp/components/general/text"
                            text="&lt;p>&amp;quot;The extreme sports package was beyond my wildest dreams. From skydiving to white-water rafting, every activity was thrilling and perfectly organized. The guides made us feel safe and exhilarated at every turn.&amp;quot;&lt;/p>&#xd;&#xa;&lt;h3>Emily R.&lt;/h3>&#xd;&#xa;"
