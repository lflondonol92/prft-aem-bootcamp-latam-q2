                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="aem-bootcamp/components/general/text"
                            text="&lt;p>&amp;quot;The jungle safari was a dream come true. We saw so many incredible animals and learned a lot about the ecosystem. Highly recommended!&amp;quot;&lt;/p>&#xd;&#xa;&lt;h3>John D.&lt;/h3>&#xd;&#xa;"
